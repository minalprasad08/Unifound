# UniFound Global Environment Configuration Template

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database Configuration
# PostgreSQL example: postgresql://unifound_user:unifound_password@localhost:5432/unifound_db
# Default to SQLite for local development:
DATABASE_URL=sqlite:///./unifound.db

# JWT & Security Configuration
SECRET_KEY=unifound_super_secret_jwt_key_change_in_production_2026_xyz!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,webp

# MCP Server Configuration (Phase 10)
MCP_ENABLED=true
MCP_SERVER_NAME=unifound
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_REQUEST_TIMEOUT=30

# Agentic AI & ReAct Orchestrator Configuration (Phase 11)
LLM_PROVIDER=heuristic
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=
LLM_FALLBACK_PROVIDER=heuristic
LLM_REQUEST_TIMEOUT=15
AGENT_MAX_ITERATIONS=5
