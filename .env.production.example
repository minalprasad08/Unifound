# ==============================================================================
# UniFound — Production Environment Configuration Template
# ==============================================================================
# Instructions:
# Copy this file to .env on the production server.
# Ensure all placeholders are replaced with strong, cryptographically secure values.
# Do NOT commit production .env to version control.
# ==============================================================================

# Server Environment
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="UniFound – Enterprise Lost & Found Management System"
VERSION=1.0.0
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# PostgreSQL Production Database Configuration
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://unifound_admin:REPLACE_WITH_SECURE_PG_PASSWORD_2026@localhost:5432/unifound_production

# JWT & Cryptographic Security
# Must be at least 32 characters long. In production, use a 64+ char random hex or urlsafe string.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_SECURE_CRYPTOGRAPHIC_SECRET_KEY_MIN_32_CHARS_LONG_2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Network & Host Security
ALLOWED_HOSTS=unifound.campus.edu,api.unifound.campus.edu,localhost,127.0.0.1
ALLOWED_ORIGINS=https://unifound.campus.edu,https://api.unifound.campus.edu,http://localhost:5173

# Rate Limiting Quotas (per IP per minute)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_AGENT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_CLAIM_PER_MINUTE=15

# File Upload & Media Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,webp

# Model Context Protocol (MCP) Server (Phase 10)
MCP_ENABLED=True
MCP_SERVER_NAME=unifound
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_REQUEST_TIMEOUT=30

# Agentic AI & ReAct Orchestrator (Phase 11)
LLM_PROVIDER=heuristic
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=
LLM_FALLBACK_PROVIDER=heuristic
LLM_REQUEST_TIMEOUT=15
AGENT_MAX_ITERATIONS=5
